# Copy to .env and fill in. Never commit .env.

# LLM (DeepSeek chat model)
DEEPSEEK_API_KEY=

# Embeddings + vision fallback (via OpenRouter)
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
VISION_MODEL=openai/gpt-4o-mini
VISION_FALLBACK_ENABLED=true

# Vector store
PINECONE_API_KEY=
INDEX_NAME_ASOIU_02=rag-asoiu-openai-v2

# Web page ingestion
TAVILY_API_KEY=

# Corpus location (default: ./DB_ASOIU next to ingestion.py)
# ASOIU_DB_ROOT=./DB_ASOIU

# Streamlit access gate (leave empty to disable)
APP_PASSWORD=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
EMBEDDING_DIM=1536

# Optional chat model override
# CHAT_MODEL=deepseek-chat
# CHAT_MODEL_PROVIDER=deepseek

# Retrieval: "dense" (default) or "hybrid" (dense + BM25 fusion). Compare with the
# evaluation script before changing: python -m thesis_assistant.evaluation --help
# RETRIEVAL_MODE=dense
# RETRIEVAL_FETCH_K=12

# Web app accounts. Generate entries with: python -m thesis_assistant.auth
# Format: name:salt$hash;name2:salt$hash   (APP_PASSWORD is a shared-password fallback)
APP_USERS=

# Rate limit per user and SQLite state location
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
# STATE_DB_PATH=./state/thesis_assistant.db

# Observability
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# METRICS_PORT=9100
